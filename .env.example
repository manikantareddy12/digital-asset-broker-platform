# ============================================
# Loan Platform Environment Configuration
# ============================================
# Copy this file to .env and fill in values

# ===================
# Database
# ===================
POSTGRES_PASSWORD=your-strong-database-password
DB_USER=loanuser
DB_PASSWORD=your-strong-database-password

# ===================
# Kafka
# ===================
KAFKA_BROKERS=localhost:9092

# ===================
# Blockchain
# ===================
# Private key for signing transactions (without 0x prefix)
# WARNING: Never commit real private keys!
BLOCKCHAIN_PRIVATE_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
GATEWAY_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Contract addresses (set after deployment)
LOAN_REGISTRY_ADDRESS=
REPAYMENT_LEDGER_ADDRESS=

# RPC URL
ETHEREUM_RPC_URL=http://localhost:8545
CHAIN_ID=31337

# ===================
# Security
# ===================
# JWT signing secret (minimum 256 bits / 32 characters)
JWT_SECRET=your-256-bit-secret-key-for-jwt-signing-change-this-in-production

# ===================
# API URLs
# ===================
BLOCKCHAIN_GATEWAY_URL=http://localhost:3000
VITE_API_URL=http://localhost:8081/api
